   "source": [
    "\n",
    "def compute_token_gradients(model, texts, labels, top_n=20):\n",
    "    model.eval()\n",
    "    human_scores, ai_scores = Counter(), Counter()\n",
    "\n",
    "    for text, label in zip(texts, labels):\n",
    "        enc = tokenizer(text, padding=\"max_length\", truncation=True,\n",
    "                        max_length=MAX_LENGTH, return_tensors=\"pt\")\n",
    "        input_ids = enc[\"input_ids\"].to(device)\n",
    "        attention_mask = enc[\"attention_mask\"].to(device)\n",
    "\n",
    "        model.zero_grad()\n",
    "        outputs = model.bert(input_ids=input_ids, attention_mask=attention_mask)\n",
    "        cls_embedding = outputs.last_hidden_state[:, 0, :]\n",
    "        cls_embedding.retain_grad()\n",
    "\n",
    "        logits = model.classifier(cls_embedding)\n",
    "        log_probs = model.out(logits)\n",
    "        pred_class = log_probs.argmax(dim=1)\n",
    "\n",
    "        log_probs[0, pred_class].backward()\n",
    "        grads = cls_embedding.grad.squeeze(0)\n",
    "\n",
    "        tokens = tokenizer.convert_ids_to_tokens(input_ids.squeeze(0))\n",
    "        tokens = [t for t in tokens if t not in string.punctuation]\n",
    "\n",
    "        counter = ai_scores if pred_class.item() == 1 else human_scores\n",
    "        for tok, grad in zip(tokens, grads):\n",
    "            counter[tok] += grad.item()\n",
    "\n",
    "    return human_scores, ai_scores\n",
    "\n",
    "\n",
    "def visualize_token_importance(human_scores, ai_scores, top_n=20):\n",
    "    \"\"\"Plot the most influential tokens for each class.\"\"\"\n",
    "    # Convert to sorted lists\n",
    "    human_top = human_scores.most_common(top_n)\n",
    "    ai_top = ai_scores.most_common(top_n)\n",
    "\n",
    "    # Extract tokens and scores\n",
    "    human_tokens, human_vals = zip(*human_top)\n",
    "    ai_tokens, ai_vals = zip(*ai_top)\n",
    "\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(16, 7))\n",
    "\n",
    "    axes[0].barh(human_tokens[::-1], human_vals[::-1])\n",
    "    axes[0].set_title(\"Top Tokens Associated with HUMAN Writing (Gradient-Based)\")\n",
    "    axes[0].set_xlabel(\"Gradient Attribution Score\")\n",
    "\n",
    "    axes[1].barh(ai_tokens[::-1], ai_vals[::-1])\n",
    "    axes[1].set_title(\"Top Tokens Associated with AI Writing (Gradient-Based)\")\n",
    "    axes[1].set_xlabel(\"Gradient Attribution Score\")\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "# restore model\n",
    "model, optimizer, epoch_start = make_or_restore_model()\n",
    "\n",
    "# recompute token-level gradient analysis\n",
    "human_scores, ai_scores = compute_token_gradients(model, test_data, test_labels)\n",
    "\n",
    "# visualize\n",
    "visualize_token_importance(human_scores, ai_scores, top_n=20)\n"
