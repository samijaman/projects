    "## 3. Using DistilBERT\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "cWi2MfXvpva4"
   },
   "source": [
    "### 3.1 Training the Model"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "cam8K9vrpY1G"
   },
   "source": [
    "Here we train a DistilBERT model to distinguish text between classes. The model implements class-weighted loss, and performance is tracked per epoch. After each epoch, accuracy and average loss are reported for the training and test sets, providing a clear view of how well the model handles the task. The token-based feature analysis helper is also in this code block."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "bIK4hRcIo82y",
    "outputId": "38ffbce4-9113-4e4c-8ee2-2fefc14a5705"
   },
   "outputs": [],
   "source": [
    "\n",
    "from google.colab import drive\n",
    "drive.mount('/content/drive')\n",
    "\n",
    "\n",
    "EPOCHS = 5\n",
    "BATCH_SIZE = 24\n",
    "MAX_LENGTH = 256\n",
    "LR = 0.001\n",
    "CKPT_DIR = Path(\"/content/drive/MyDrive/bert_checkpoints\")\n",
    "CKPT_DIR.mkdir(exist_ok=True)\n",
    "NUM_CLASSES = 2\n",
    "\n",
    "torch.manual_seed(0)\n",
    "\n",
    "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "print(\"Using device:\", device)\n",
    "\n",
    "tokenizer = DistilBertTokenizer.from_pretrained(\"distilbert-base-uncased\")\n",
    "bert = DistilBertModel.from_pretrained(\"distilbert-base-uncased\").to(device)\n",
    "\n",
    "# 0 = human-written, 1 = AI-generated\n",
    "label_map = {\"0\": 0, \"1\": 1}\n",
    "label_map_rev = {0: \"0\", 1: \"1\"}\n",
    "\n",
    "\n",
    "class NN(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "\n",
    "        self.bert = bert\n",
    "\n",
    "        self.classifier = nn.Sequential(\n",
    "            nn.Linear(768, 256),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.2),\n",
    "            nn.Linear(256, 2)\n",
    "        )\n",
    "\n",
    "        self.out = nn.LogSoftmax(dim=1)\n",
    "\n",
    "    def forward(self, input_ids, attention_mask):\n",
    "        outputs = self.bert(input_ids=input_ids, attention_mask=attention_mask)\n",
    "        cls_embedding = outputs.last_hidden_state[:, 0, :]   # [CLS] token\n",
    "        logits = self.classifier(cls_embedding)\n",
    "        return self.out(logits)\n",
    "\n",
    "\n",
    "####\n",
    "\n",
    "# take in a list of essays and calling the tokenizer on each of them in order to return a list of tensors,\n",
    "# where each token has dtype=torch.long. return a list of (input_ids, attention_mask) pairs\n",
    "\n",
    "def prep_bert_data(data: List[str], max_length: int):\n",
    "    input_ids = []\n",
    "    attention_masks = []\n",
    "\n",
    "    for text in data:\n",
    "        enc = tokenizer(\n",
    "            text,\n",
    "            padding='max_length',\n",
    "            truncation=True,\n",
    "            max_length=max_length,\n",
    "            return_tensors=\"pt\"\n",
    "        )\n",
    "        input_ids.append(enc[\"input_ids\"].squeeze(0))\n",
    "        attention_masks.append(enc[\"attention_mask\"].squeeze(0))\n",
    "\n",
    "    return list(zip(input_ids, attention_masks))\n",
    "\n",
    "\n",
    "####\n",
    "\n",
    "\n",
    "def get_predicted_label_from_predictions(predictions):\n",
    "    predicted_label = predictions.argmax(1).item()\n",
    "    return predicted_label\n",
    "\n",
    "\n",
    "# takes four arguments: a dataset, the set of features for the dataset, the set of labels for the dataset,\n",
    "# and the model. it should randomly sample 10 indices within the dataset and retrieve model predictions\n",
    "# for those 10 essays.\n",
    "def sample_and_print_predictions(feats, data, labels, model):\n",
    "    rev = {v: k for k, v in label_map.items()}\n",
    "    for i in random.sample(range(len(data)), min(10, len(data))):\n",
    "        input_ids, attn_mask = feats[i]\n",
    "        with torch.no_grad():\n",
    "            pred = model(\n",
    "                input_ids.unsqueeze(0).to(device),\n",
    "                attn_mask.unsqueeze(0).to(device)\n",
    "            )\n",
    "            pred_label = torch.argmax(pred, 1).item()\n",
    "        print(\"Essay:\", data[i][:300], \"...\")\n",
    "        print(\"- Class:\", rev[int(labels[i])])\n",
    "        print(\"- Prediction:\", rev[pred_label])\n",
    "        print()\n",
    "\n",
    "\n",
    "# prints a summary of accuracy by category. takes two parameters: a list of labels (such as test_labels)\n",
    "# and a list of model predictions (as tensors).\n",
    "def print_performance_by_class(labels, predictions):\n",
    "    generated = [\"0\", \"1\"]\n",
    "    print(\"\\nAccuracy by Category:\")\n",
    "\n",
    "    labels = torch.tensor(labels)\n",
    "    # predictions is a list of log-prob tensors\n",
    "    preds = torch.tensor(\n",
    "        [torch.argmax(p).item() if p.ndim > 0 else p.item() for p in predictions]\n",
    "    )\n",
    "\n",
    "    for i, writer in enumerate(generated):\n",
    "        mask = labels == i\n",
    "        if mask.sum().item() == 0:\n",
    "            print(writer + \": N/A (no examples)\")\n",
    "            continue\n",
    "        acc = (preds[mask] == labels[mask]).float().mean().item()\n",
    "        print(writer + \": \" + str(round(acc * 100, 1)) + \"%\")\n",
    "\n",
    "\n",
    "def train(dataloader, model, optimizer, epoch: int):\n",
    "    \"\"\"Run an epoch of training the model on the provided data, using the\n",
    "    specified optimizer.\n",
    "    \"\"\"\n",
    "    global class_weights\n",
    "    loss_fn = nn.NLLLoss(weight=class_weights)  # changed weights\n",
    "\n",
    "    model.train()\n",
    "    with tqdm(dataloader, unit=\"batch\", desc=f\"Epoch {epoch}\") as tbatch:\n",
    "        for (input_ids, attn_mask), y in tbatch:\n",
    "            input_ids = input_ids.to(device)\n",
    "            attn_mask = attn_mask.to(device)\n",
    "            y = y.to(device)\n",
    "\n",
    "            pred = model(input_ids, attn_mask)\n",
    "            loss = loss_fn(pred, y)\n",
    "\n",
    "            # backpropagation\n",
    "            optimizer.zero_grad()\n",
    "            loss.backward()\n",
    "            optimizer.step()\n",
    "\n",
    "\n",
    "def predict(data, model):\n",
    "    predictions = []\n",
    "    dataloader = DataLoader(data, batch_size=1, shuffle=False)\n",
    "    with torch.no_grad():\n",
    "        for (input_ids, attn_mask) in dataloader:\n",
    "            input_ids = input_ids.to(device)\n",
    "            attn_mask = attn_mask.to(device)\n",
    "            pred = model(input_ids, attn_mask)\n",
    "            predictions.append(pred.cpu())\n",
    "    return predictions\n",
    "\n",
    "\n",
    "def test(dataloader, model, dataset_name):\n",
    "    loss_fn = nn.NLLLoss()\n",
    "    size = len(dataloader.dataset)\n",
    "    num_batches = len(dataloader)\n",
    "    model.eval()\n",
    "    test_loss, correct = 0, 0\n",
    "    with torch.no_grad():\n",
    "        for (input_ids, attn_mask), y in dataloader:\n",
    "            input_ids = input_ids.to(device)\n",
    "            attn_mask = attn_mask.to(device)\n",
    "            y = y.to(device)\n",
    "            pred = model(input_ids, attn_mask)\n",
    "            test_loss += loss_fn(pred, y).item()\n",
    "            correct += (pred.argmax(1) == y).type(torch.float).sum().item()\n",
    "    test_loss /= num_batches\n",
    "    correct /= size\n",
    "    print(\n",
    "        f\"{dataset_name} Accuracy: {(100 * correct):>0.1f}%, Avg loss: {test_loss:>6f}\\n\"\n",
    "    )\n",
    "\n",
    "\n",
    "####\n",
    "\n",
    "\n",
    "def make_or_restore_model() -> Tuple[nn.Module, torch.optim.Optimizer, int]:\n",
    "    \"\"\"Either restore the latest model, or create a fresh one\"\"\"\n",
    "    model = NN().to(device)\n",
    "    optimizer = torch.optim.SGD(model.parameters(), lr=LR, momentum=0.9)\n",
    "    ckpt_path = Path(CKPT_DIR)\n",
    "    ckpt_path.mkdir(exist_ok=True)\n",
    "    checkpoints = [p for p in ckpt_path.glob(\"*.pt\")]\n",
    "\n",
    "    if checkpoints:\n",
    "        latest_checkpoint = max(\n",
    "            checkpoints,\n",
    "            key=lambda p: int(p.stem.split('_')[1])\n",
    "        )\n",
    "        print(\"Restoring from\", latest_checkpoint)\n",
    "        ckpt = torch.load(latest_checkpoint, map_location=device)\n",
    "        model.load_state_dict(ckpt[\"model_state_dict\"])\n",
    "        optimizer.load_state_dict(ckpt[\"optimizer_state_dict\"])\n",
    "        epoch = ckpt[\"epoch\"]\n",
    "        return model, optimizer, epoch + 1\n",
    "    else:\n",
    "        print(\"Creating a new model\")\n",
    "        return model, optimizer, 0\n",
    "\n",
    "\n",
    "####\n",
    "\n",
    "\n",
    "def feature_analysis(model, texts: List[str], labels: List[int], top_n: int = 20):\n",
    "    \"\"\"\n",
    "    Identify top tokens influencing AI vs human predictions, class-wise.\n",
    "    Excludes punctuation.\n",
    "    \"\"\"\n",
    "    model.eval()\n",
    "    human_scores, ai_scores = Counter(), Counter()\n",
    "\n",
    "    for text, label in zip(texts, labels):\n",
    "        enc = tokenizer(text, padding=\"max_length\", truncation=True, max_length=MAX_LENGTH, return_tensors=\"pt\")\n",
    "        input_ids = enc[\"input_ids\"].to(device)\n",
    "        attention_mask = enc[\"attention_mask\"].to(device)\n",
    "\n",
    "        model.zero_grad()\n",
    "        outputs = model.bert(input_ids=input_ids, attention_mask=attention_mask)\n",
    "        cls_embedding = outputs.last_hidden_state[:, 0, :]\n",
    "        cls_embedding.retain_grad()\n",
    "\n",
    "        logits = model.classifier(cls_embedding)\n",
    "        log_probs = model.out(logits)\n",
    "        pred_class = log_probs.argmax(dim=1)\n",
    "\n",
    "        # backward to get gradient\n",
    "        log_probs[0, pred_class].backward()\n",
    "        grads = cls_embedding.grad.squeeze(0)\n",
    "\n",
    "        tokens = tokenizer.convert_ids_to_tokens(input_ids.squeeze(0))\n",
    "        tokens = [t for t in tokens if t not in string.punctuation]\n",
    "\n",
    "        counter = ai_scores if pred_class.item() == 1 else human_scores\n",
    "        for tok, grad in zip(tokens, grads):\n",
    "            counter[tok] += grad.item()\n",
    "\n",
    "    print(f\"\\nTop {top_n} tokens associated with HUMAN writing:\")\n",
    "    for tok, score in human_scores.most_common(top_n):\n",
    "        print(f\"{tok}: {score:.4f}\")\n",
    "\n",
    "    print(f\"\\nTop {top_n} tokens associated with AI writing:\")\n",
    "    for tok, score in ai_scores.most_common(top_n):\n",
    "        print(f\"{tok}: {score:.4f}\")\n",
    "\n",
    "\n",
    "\n",
    "def main():\n",
    "    \"\"\"Run AI vs non-AI essay classification with feature analysis.\"\"\"\n",
    "\n",
    "    train_data = list(X_train)\n",
    "    test_data = list(X_test)\n",
    "    train_labels = [label_map[str(val)] for val in y_train]\n",
    "    test_labels = [label_map[str(val)] for val in y_test]\n",
    "\n",
    "    for i in label_map_rev:\n",
