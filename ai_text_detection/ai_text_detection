    "import nltk\n",
    "import textstat\n",
    "\n",
    "nltk.download('punkt')\n",
    "nltk.download('punkt_tab')\n",
    "\n",
    "# assume test_data (list of essays) and test_labels (0=human, 1=AI) are already defined\n",
    "\n",
    "def compute_stylometric_features(texts, labels):\n",
    "    features = {\n",
    "        'avg_sentence_length': [],\n",
    "        'sentence_length_var': [],\n",
    "        'complex_sentence_ratio': [],\n",
    "        'vocab_richness': [],\n",
    "        'rare_word_ratio': [],\n",
    "        'flesch_reading_ease': [],\n",
    "        'gunning_fog': [],\n",
    "        'comma_freq': [],\n",
    "        'semicolon_freq': [],\n",
    "        'exclamation_freq': [],\n",
    "        'quote_freq': [],\n",
    "        'dash_freq': []\n",
    "    }\n",
    "\n",
    "    # build overall word frequency for rare word calculation\n",
    "    all_words = [word.lower() for essay in texts for word in nltk.word_tokenize(essay)]\n",
    "    word_counts = Counter(all_words)\n",
    "    rare_words = {word for word, count in word_counts.items() if count == 1}  # words appearing once\n",
    "\n",
    "    for text in texts:\n",
    "        sentences = nltk.sent_tokenize(text)\n",
    "        words = nltk.word_tokenize(text)\n",
    "        num_words = len(words)\n",
    "\n",
    "        # sentence-level\n",
    "        sentence_lengths = [len(nltk.word_tokenize(s)) for s in sentences]\n",
    "        avg_len = np.mean(sentence_lengths) if sentence_lengths else 0\n",
    "        var_len = np.var(sentence_lengths) if sentence_lengths else 0\n",
    "        complex_sentences = sum(1 for s in sentences if ',' in s or ';' in s or ':' in s)\n",
    "        complex_ratio = complex_sentences / len(sentences) if sentences else 0\n",
    "\n",
    "        # word-level\n",
    "        vocab_richness = len(set(words)) / num_words if num_words > 0 else 0\n",
    "        rare_word_count = sum(1 for w in words if w.lower() in rare_words)\n",
    "        rare_word_ratio = rare_word_count / num_words if num_words > 0 else 0\n",
    "\n",
    "        # readability\n",
    "        flesch = textstat.flesch_reading_ease(text)\n",
    "        fog = textstat.gunning_fog(text)\n",
    "\n",
    "        # punctuation & formatting\n",
    "        comma_freq = text.count(',') / num_words if num_words > 0 else 0\n",
    "        semicolon_freq = text.count(';') / num_words if num_words > 0 else 0\n",
    "        exclamation_freq = text.count('!') / num_words if num_words > 0 else 0\n",
    "        quote_freq = text.count('\"') / num_words if num_words > 0 else 0\n",
    "        dash_freq = text.count('-') / num_words if num_words > 0 else 0\n",
    "\n",
    "        # append to features\n",
    "        features['avg_sentence_length'].append(avg_len)\n",
    "        features['sentence_length_var'].append(var_len)\n",
    "        features['complex_sentence_ratio'].append(complex_ratio)\n",
    "        features['vocab_richness'].append(vocab_richness)\n",
    "        features['rare_word_ratio'].append(rare_word_ratio)\n",
    "        features['flesch_reading_ease'].append(flesch)\n",
    "        features['gunning_fog'].append(fog)\n",
    "        features['comma_freq'].append(comma_freq)\n",
    "        features['semicolon_freq'].append(semicolon_freq)\n",
    "        features['exclamation_freq'].append(exclamation_freq)\n",
    "        features['quote_freq'].append(quote_freq)\n",
    "        features['dash_freq'].append(dash_freq)\n",
    "\n",
    "    df_features = pd.DataFrame(features)\n",
    "    df_features['label'] = labels\n",
    "    return df_features\n",
    "\n",
    "# compute features\n",
    "df_stylometric = compute_stylometric_features(test_data, test_labels)\n",
    "df_stylometric.head()\n",
    "\n",
    "# compare avg vals per class\n",
    "df_stylometric.groupby('label').mean()\n"
